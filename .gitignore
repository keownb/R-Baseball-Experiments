# History files
.Rhistory
.Rapp.history

# Session Data files
.RData

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# macOS
.DS_Store

# data_cache/: keep the small MLB Stats API supplement CSVs (reproducible builds),
# but not the 50 MB Baseball-Reference feeds, which load_war_data() re-downloads.
!data_cache/
data_cache/br_*.txt

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Rendered plots are deployed to Cloudflare (npx wrangler deploy), not versioned.
# Regenerate with generate_all_plots.R / generate_team_breakdowns.R.
docs/plots/
docs/plots_fg/
docs/team_breakdowns/
docs/team_breakdowns_fg/

# build.sh staging area, logs, and per-build render manifests (docs/build.json is versioned)
build/
docs/build/
